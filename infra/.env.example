# Local Docker Compose settings.
# Copy this file to infra/.env.local and adjust values for your machine.
# Do not commit real production secrets.

POSTGRES_DB=jababdihi
POSTGRES_USER=jababdihi
POSTGRES_PASSWORD=jababdihi_dev_password
POSTGRES_PORT=5432

REDIS_PORT=6379

BACKEND_API_PORT=8080
FRONTEND_PORT=3000
OLLAMA_PORT=11434

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Shared deployment examples. Copy .env.staging.example or .env.prod.example on the VPS.
BACKEND_IMAGE=ghcr.io/tahniat-ashraf/jababdihi-backend:local
SERVER_NAME=localhost
FRONTEND_ORIGIN=http://localhost:3000
APP_ADMIN_API_KEY=dev-api-key
LOG_LEVEL=INFO
