# Staging environment — copy to /opt/jababdihi/staging/.env on the VPS.
# Never commit real values.

# ── Docker image ─────────────────────────────────────────────────────────────
# The deploy script replaces this with the actual image tag.
BACKEND_IMAGE=ghcr.io/tahniat-ashraf/jababdihi-backend:<IMAGE_TAG>

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=jababdihi_staging
POSTGRES_USER=jababdihi_staging
POSTGRES_PASSWORD=<REPLACE_WITH_STRONG_PASSWORD>
# Docker Compose builds SPRING_DATASOURCE_URL from the POSTGRES_* vars above.
# No separate DATABASE_URL is needed in this file.

# ── Redis ─────────────────────────────────────────────────────────────────────
# Always "redis" inside Docker Compose — do not change.
REDIS_HOST=redis
REDIS_PORT=6379

# ── Spring Boot ───────────────────────────────────────────────────────────────
# Docker Compose overrides this per service (api,staging / worker,staging).
SPRING_PROFILES_ACTIVE=api,staging
SERVER_PORT=8080
INGESTION_ITEM_LIMIT=10

# ── Internal API key ──────────────────────────────────────────────────────────
# Used for machine-to-machine calls (Next.js → backend internal admin APIs).
# Must match ADMIN_API_KEY in the Next.js frontend .env.
APP_ADMIN_API_KEY=<REPLACE_WITH_STRONG_KEY>

# ── Admin UI Basic Auth ───────────────────────────────────────────────────────
# Configured in the Next.js frontend middleware.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=<REPLACE_WITH_BCRYPT_HASH>

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for browser requests to the API.
CORS_ALLOWED_ORIGINS=https://<YOUR_STAGING_FRONTEND_DOMAIN>

# ── NGINX ─────────────────────────────────────────────────────────────────────
SERVER_NAME=staging-api.<YOUR_DOMAIN>
FRONTEND_ORIGIN=https://<YOUR_STAGING_FRONTEND_DOMAIN>
# Staging uses port 8081 so it can coexist with production on the same VPS.
# Your host-level proxy or Cloudflare tunnel for staging-api.<domain> routes here.
NGINX_HTTP_PORT=8081

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Telegram alerts ──────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=<REPLACE_WITH_TOKEN>
TELEGRAM_CHAT_ID=<REPLACE_WITH_CHAT_ID>
QUEUE_DEPTH_ALERT_THRESHOLD=1000
BACKFILL_STUCK_HOURS=6

# ── Backups ───────────────────────────────────────────────────────────────────
S3_ENDPOINT=https://s3.us-west-002.backblazeb2.com
S3_BUCKET=jababdihi-staging-backups
S3_ACCESS_KEY_ID=<REPLACE_WITH_ACCESS_KEY>
S3_SECRET_ACCESS_KEY=<REPLACE_WITH_SECRET_KEY>
BACKUP_ENCRYPTION_PASSPHRASE=<REPLACE_WITH_STRONG_PASSPHRASE>
