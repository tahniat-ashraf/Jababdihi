server {
    listen 80;
    server_name ${SERVER_NAME};

    # TLS is terminated upstream (Cloudflare or host-level proxy).
    # This container handles HTTP only; X-Forwarded-Proto is set by the upstream.

    client_max_body_size 2m;

    # Concurrent connection limit per IP (defence-in-depth behind Cloudflare).
    limit_conn conn_zone 40;

    # ── Security headers ────────────────────────────────────────────────────
    add_header X-Content-Type-Options  nosniff                         always;
    add_header X-Frame-Options         DENY                            always;
    add_header Referrer-Policy         strict-origin-when-cross-origin always;

    # ── Health check ────────────────────────────────────────────────────────
    # Exposed for deploy scripts and external monitoring.
    location = /actuator/health {
        limit_req zone=health_zone burst=10 nodelay;

        proxy_pass         http://${BACKEND_API_UPSTREAM}/actuator/health;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout    10s;
        proxy_send_timeout    10s;
    }

    # ── Block all other /actuator/* and /internal/* paths ───────────────────
    location /actuator/ {
        return 404;
    }

    location /internal/ {
        return 403;
    }

    # ── Public API ──────────────────────────────────────────────────────────
    location /api/ {
        # 60 req/min average; burst=30 lets a genuine page-load spike through
        # without error, then enforces the limit.  nodelay returns 429
        # immediately once the burst queue is full (no queuing delay).
        limit_req zone=api_zone burst=30 nodelay;

        proxy_pass         http://${BACKEND_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout    30s;
        proxy_read_timeout    60s;
    }

    # ── Root fallback ───────────────────────────────────────────────────────
    location / {
        add_header Content-Type text/plain;
        return 200 "Jababdihi backend API — frontend at ${FRONTEND_ORIGIN}\n";
    }
}
