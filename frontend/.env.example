# ─── Backend API connection ──────────────────────────────────────────────────
#
# Server-side variable (never exposed to the browser) used by Next.js API
# routes to proxy requests to the Spring Boot backend.
# Takes precedence over NEXT_PUBLIC_API_BASE_URL when both are set.
#
# Set this on Vercel as a plain environment variable (not "Public").
BACKEND_API_BASE_URL=http://localhost:8080

# Public variable — exposed to the browser bundle.
# Used as a fallback when BACKEND_API_BASE_URL is absent.
# On Vercel, set this to the full public URL of the staging or production API.
#
# Preview:    NEXT_PUBLIC_API_BASE_URL=https://staging-api.<domain>
# Production: NEXT_PUBLIC_API_BASE_URL=https://api.<domain>
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ─── Admin UI — Basic Auth (Next.js middleware) ──────────────────────────────
# Protects all routes under /admin. Change these before deploying.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ─── Admin API key — machine-to-machine (Next.js → Spring Boot) ─────────────
# Used by Next.js API route handlers that call /internal/admin/* on the backend.
# Must match APP_ADMIN_API_KEY configured on the Spring Boot backend.
ADMIN_API_KEY=dev-api-key
